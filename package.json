{
  "name": "kipubankv2",
  "version": "2.0.0",
  "description": "Advanced multi-token vault with Chainlink price feeds and role-based access control",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:localhost": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:goerli": "hardhat run scripts/deploy.js --network goerli",
    "deploy:nico": "hardhat run scripts/deploy-nico-token.js",
    "deploy:complete": "hardhat run scripts/deploy-complete.js",
    "deploy:nico-custom": "hardhat run scripts/deploy-nico-with-custom-price.js",
    "verify:sepolia": "hardhat verify --network sepolia",
    "verify:goerli": "hardhat verify --network goerli",
    "interact": "hardhat run scripts/interact.js",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "size": "hardhat size-contracts",
    "gas-report": "REPORT_GAS=true hardhat test"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "smart-contract",
    "defi",
    "vault",
    "multi-token",
    "chainlink",
    "openzeppelin",
    "solidity",
    "hardhat"
  ],

# Copy this file to .env and fill in your actual values

# Infura Project ID for connecting to Ethereum networks
# Get one at: https://infura.io/
INFURA_PROJECT_ID=your-infura-project-id-here

# Private key of the account you want to deploy from (without 0x prefix)
# NEVER commit your actual private key to version control!
# Use a dedicated deployment wallet with minimal funds
PRIVATE_KEY=your-private-key-here

# Etherscan API key for contract verification
# Get one at: https://etherscan.io/apis
ETHERSCAN_API_KEY=your-etherscan-api-key-here

# CoinMarketCap API key for gas reporting (optional)
# Get one at: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key-here

# Contract address after deployment (used by interaction scripts)
CONTRACT_ADDRESS=0x...

# Network configuration
NETWORK=sepolia

# Optional: Custom withdrawal limits (in ETH for native token)
DEFAULT_ETH_WITHDRAWAL_LIMIT=10

# Optional: Admin address (if different from deployer)
ADMIN_ADDRESS=your-admin-address-here
